{
	"geode": "5.10.1",
	"gd": {
		"win": "2.2081",
		"android": "2.2081",
		"mac": "2.2081",
		"ios": "2.2081"
	},
	"id": "rony.searchwizard",
	"name": "SearchWizard",
	"version": "v1.0.0",
	"developer": "Rony",
	"description": "A redesigned and improved object search and creation toolkit for Geometry Dash.",
	"dependencies": {
		"geode.node-ids": ">=v1.13.2",
		"alphalaneous.object_popup_api": ">=v1.0.2"
	},
	"resources": {
		"sprites": [
			"resources/*.png"
		],
		"files": [
			"resources/shaders/*"
		]
	},
	"settings": {
		"enable-new-tab-ui": {
			"name": "New Tab UI",
			"description": "Revamps the bottom tab UI",
			"type": "bool",
			"default": true
		},
		"enable-tooltips": {
			"name": "Tooltips",
			"description": "Show tooltips in the bottom tab UI",
			"type": "bool",
			"default": true
		},
		"tooltip-scale": {
			"name": "Tooltip Scale",
			"description": "Scale the tooltip size",
			"type": "float",
			"default": 1,
			"min": 0.3,
			"max": 3,
			"control": {
				"slider": true
			}
		},
		"blur-strength": {
			"name": "Blur Strength",
			"description": "The strength of the blur (0 to disable)",
			"type": "int",
			"default": 5,
			"min": 0,
			"max": 20,
			"control": {
				"slider": true
			},
			"platforms": [
				"win"
			]
		},
		"selection-color": {
			"name": "Selection Color",
			"type": "rgb",
			"default": [170, 100, 255]
		},
		"line-color": {
			"name": "Line Color",
			"type": "rgb",
			"default": [220, 200, 255]
		},
		"gradient-top-color": {
			"name": "Gradient Top Color",
			"type": "rgba",
			"default": [55, 35, 90, 220]
		},
		"gradient-bottom-color": {
			"name": "Gradient Bottom Color",
			"type": "rgba",
			"default": [20, 15, 40, 180]
		},
		"gradient-overlay-opacity": {
			"name": "Gradient Overlay Opacity",
			"type": "float",
			"default": 0.65,
			"min": 0,
			"max": 1
		}
	},
	"tags": [
		"editor"
	],
	"links": {
		"source": "https://github.com/RonyJvr/SearchWizard"
	}
}
